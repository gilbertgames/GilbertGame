#pragma once

#include "/GilbertShaders/Private/GilbertCommon.ush"

//////////////////////////////////////////////////////////////
// GILBERT TENSOR
// Structure tensor computation, eigenvalue decomposition,
// and direction/anisotropy solving.
// Depends on: GilbertCommon.ush
//////////////////////////////////////////////////////////////

//////////////////////////////////////////////////////////////
// DEFAULTS
// Override these in your .usf before including this file.
//////////////////////////////////////////////////////////////

#ifndef TENSOR_EPSILON
#define TENSOR_EPSILON 1e-5
#endif

// Tensor source mode — controls what ComputeDirectionData uses.
//   SCENECOLOR : Color gradients (Gaussian-smoothed Sobel on luma).
//                Matches paper + Acerola exactly.
//                Anisotropy varies everywhere there's texture/color contrast.
//   NORMALS    : World normal derivatives. Only responds to geometric curvature.
//                Anisotropy is near-zero on flat surfaces regardless of texture.
//   HYBRID     : Direction from normals, anisotropy from color.
#define TENSOR_SOURCE_NORMALS    0
#define TENSOR_SOURCE_SCENECOLOR 1
#define TENSOR_SOURCE_HYBRID     2

#ifndef TENSOR_SOURCE
#define TENSOR_SOURCE TENSOR_SOURCE_SCENECOLOR
#endif

#ifndef TENSOR_NORMAL_BLEND
#define TENSOR_NORMAL_BLEND 0.75
#endif

#ifndef ROTATE_TENSOR_DIRECTION_90
#define ROTATE_TENSOR_DIRECTION_90 0
#endif

// -------------------------------------------------------
// TENSOR BLUR (SCENECOLOR path only)
//
// Acerola's anisotropic shader runs the structure tensor
// through two separate Gaussian blur compute passes before
// eigendecomposing. Without this smoothing step:
//   - Any single-pixel Sobel noise registers as strong anisotropy
//   - Direction changes incoherently pixel-to-pixel
//   - Net result looks like a plain circular blur
//
// We replicate this inline by accumulating the per-pixel
// gradient tensor over a neighborhood with Gaussian weights,
// then eigendecomposing the accumulated result.
//
// TENSOR_BLUR_RADIUS: neighbourhood half-size in pixels.
//   Acerola's default _BlurRadius = 2 (5x5 neighbourhood).
//   A value of 3 (7x7) is slightly smoother and recommended.
//   Higher values = smoother direction fields, more samples.
//
// TENSOR_SIGMA: Gaussian standard deviation.
//   Acerola uses sigma = 2.0. Keep this matched to BlurRadius.
// -------------------------------------------------------
#ifndef TENSOR_BLUR_RADIUS
#define TENSOR_BLUR_RADIUS 3
#endif

#ifndef TENSOR_SIGMA
#define TENSOR_SIGMA 2.0
#endif

// How many texels to step when sampling neighbors for the
// normal-based curvature tensor. 2-4 is a good range.
#ifndef TENSOR_CURVATURE_SAMPLE_RADIUS
#define TENSOR_CURVATURE_SAMPLE_RADIUS 3.0
#endif

//////////////////////////////////////////////////////////////
// STRUCTS
//////////////////////////////////////////////////////////////

struct FTensorData
{
    float A; // E = fx*fx
    float B; // F = fx*fy
    float C; // G = fy*fy
};

struct FDirectionData
{
    float2 Direction;
    float  Angle;
    float  Anisotropy;
    float  Trace;
};

//////////////////////////////////////////////////////////////
// HDR-SAFE LUMA
//
// The Sobel gradient must work on LDR-range values.
// GetSceneColor returns raw HDR scene color (AfterDOF),
// so we tonemap before computing luma — otherwise bright
// sky/specular dominates the tensor and makes everything
// appear strongly anisotropic.
//
// Matches Acerola's assumption: his buffer is already LDR.
//////////////////////////////////////////////////////////////

float GetTonemappedLuma(float2 UV)
{
    float3 HDR  = GetSceneColor(UV);
    float  Luma = dot(HDR, float3(0.2126, 0.7152, 0.0722));
    float3 LDR  = HDR / (1.0 + Luma);      // Same Reinhard as FilterTonemap
    return dot(LDR, float3(0.2126, 0.7152, 0.0722));
}

//////////////////////////////////////////////////////////////
// TENSOR SOURCES (per-pixel, un-smoothed)
//////////////////////////////////////////////////////////////

FTensorData ComputeTensorSampleFromNormals(float2 UV, float2 TexelSize)
{
    float3 N  = GetWorldNormal(UV);
    float3 Nx = GetWorldNormal(UV + float2(TexelSize.x, 0.0));
    float3 Ny = GetWorldNormal(UV + float2(0.0, TexelSize.y));

    float3 dNdx = Nx - N;
    float3 dNdy = Ny - N;

    FTensorData T;
    T.A = dot(dNdx, dNdx);
    T.B = dot(dNdx, dNdy);
    T.C = dot(dNdy, dNdy);
    return T;
}

FTensorData ComputeTensorSampleFromSceneColor(float2 UV, float2 TexelSize)
{
    // Sobel on HDR-safe tonemapped luma — paper §3.1, matches Acerola.
    // Layout is column-major (X outer, Y inner) to match our loop order.
    float SobelX[9] =
    {
        -1.0, -2.0, -1.0,  // X=-1 column
         0.0,  0.0,  0.0,  // X=0  column
         1.0,  2.0,  1.0   // X=+1 column
    };

    float SobelY[9] =
    {
        -1.0,  0.0,  1.0,  // X=-1 column, rows Y=-1,0,+1
        -2.0,  0.0,  2.0,  // X=0  column
        -1.0,  0.0,  1.0   // X=+1 column
    };

    float Gx = 0.0;
    float Gy = 0.0;
    int   Idx = 0;

    [unroll]
    for (int X = -1; X <= 1; ++X)
    {
        [unroll]
        for (int Y = -1; Y <= 1; ++Y)
        {
            float L = GetTonemappedLuma(UV + float2(X, Y) * TexelSize);
            Gx += L * SobelX[Idx];
            Gy += L * SobelY[Idx];
            Idx++;
        }
    }

    FTensorData T;
    T.A = Gx * Gx;
    T.B = Gx * Gy;
    T.C = Gy * Gy;
    return T;
}

FTensorData BlendTensors(FTensorData A, FTensorData B, float BlendToB)
{
    FTensorData T;
    T.A = lerp(A.A, B.A, BlendToB);
    T.B = lerp(A.B, B.B, BlendToB);
    T.C = lerp(A.C, B.C, BlendToB);
    return T;
}

//////////////////////////////////////////////////////////////
// GAUSSIAN-SMOOTHED TENSOR (SCENECOLOR path)
//
// Replicates Acerola's CS_HorizontalBlurPass + CS_CalculateAnisotropy
// as a single inline 2D Gaussian accumulation.
//
// Per sample: 4 tonemapped luma reads (central difference in X and Y).
// Total reads: (2*R+1)^2 * 4.  With R=3: 49 * 4 = 196 luma reads.
//
// Central difference is used per sample (cheaper than full Sobel),
// which is fine because the Gaussian smoothing that follows is what
// does the heavy lifting for coherent direction fields.
//////////////////////////////////////////////////////////////

FTensorData ComputeSmoothedTensorFromSceneColor(float2 UV, float2 TexelSize)
{
    float AccA = 0.0, AccB = 0.0, AccC = 0.0, TotalW = 0.0;

    float InvTwoSigmaSq = 1.0 / (2.0 * TENSOR_SIGMA * TENSOR_SIGMA);

    for (int TY = -TENSOR_BLUR_RADIUS; TY <= TENSOR_BLUR_RADIUS; TY++)
    {
        for (int TX = -TENSOR_BLUR_RADIUS; TX <= TENSOR_BLUR_RADIUS; TX++)
        {
            float2 SampleUV = UV + float2(TX, TY) * TexelSize;

            // Central-difference gradient on tonemapped luma.
            // Equivalent to Acerola's simple Sx/Sy per-pixel computation.
            float Lx = GetTonemappedLuma(SampleUV + float2( TexelSize.x, 0.0))
                     - GetTonemappedLuma(SampleUV + float2(-TexelSize.x, 0.0));
            float Ly = GetTonemappedLuma(SampleUV + float2(0.0,  TexelSize.y))
                     - GetTonemappedLuma(SampleUV + float2(0.0, -TexelSize.y));

            // 2D Gaussian weight — equivalent to the separable H + V blur passes.
            float D2 = float(TX * TX + TY * TY);
            float W  = exp(-D2 * InvTwoSigmaSq);

            AccA   += Lx * Lx * W;
            AccB   += Lx * Ly * W;
            AccC   += Ly * Ly * W;
            TotalW += W;
        }
    }

    float InvW = 1.0 / max(TotalW, 1e-8);

    FTensorData T;
    T.A = AccA * InvW;
    T.B = AccB * InvW;
    T.C = AccC * InvW;
    return T;
}

//////////////////////////////////////////////////////////////
// TENSOR SOLVER
// Eigendecomposition → direction angle and anisotropy ratio.
// Paper §3.1: λ1,2 = (E+G ± sqrt((E-G)^2 + 4F^2)) / 2
//             t     = (λ1-E, -F)  (eigenvector, min rate of change)
//             A     = (λ1-λ2) / (λ1+λ2)
//////////////////////////////////////////////////////////////

FDirectionData SolveTensorDirectionAndAnisotropy(FTensorData T)
{
    float E = T.A;
    float F = T.B;
    float G = T.C;

    float Trace   = E + G;
    float Delta   = sqrt(max((E - G) * (E - G) + 4.0 * F * F, 0.0));
    float Lambda1 = 0.5 * (Trace + Delta);
    float Lambda2 = 0.5 * (Trace - Delta);

    // Eigenvector of minimum eigenvalue = direction of minimum change = along edges.
    // Matches Acerola: float2 v = float2(lambda1 - g.x, -g.z) where g.x=E, g.z=F.
    float2 V   = float2(Lambda1 - E, -F);
    float2 Dir = (length(V) > 1e-6) ? normalize(V) : float2(0.0, 1.0);

    // Rotate 90° so the kernel stretches ALONG the flow direction,
    // matching Acerola's phi convention: phi = -atan2(t.y, t.x).
#if ROTATE_TENSOR_DIRECTION_90
    Dir = float2(-Dir.y, Dir.x);
#endif

    FDirectionData Out;
    Out.Direction  = Dir;
    Out.Angle      = atan2(Dir.y, Dir.x);
    Out.Anisotropy = saturate((Lambda1 - Lambda2) / max(Lambda1 + Lambda2, TENSOR_EPSILON));
    Out.Trace      = Trace;
    return Out;
}

//////////////////////////////////////////////////////////////
// TENSOR PIPELINE — single entry point for the Kuwahara pass.
// Branches on TENSOR_SOURCE so .usf overrides take effect.
//////////////////////////////////////////////////////////////

FDirectionData ComputeDirectionData(float2 UV, float2 TexelSize)
{
#if TENSOR_SOURCE == TENSOR_SOURCE_SCENECOLOR
    // -----------------------------------------------------------
    // Pure scene colour path.
    // Gaussian-smoothed structure tensor from colour gradients.
    // Matches paper §3.1 and Acerola's multi-pass pipeline exactly.
    //
    // The Gaussian smoothing is critical:
    //   Without it → noisy direction field → looks like plain blur.
    //   With it    → coherent directional strokes + correct anisotropy.
    // -----------------------------------------------------------
    FTensorData T = ComputeSmoothedTensorFromSceneColor(UV, TexelSize);
    return SolveTensorDirectionAndAnisotropy(T);

#elif TENSOR_SOURCE == TENSOR_SOURCE_HYBRID
    // -----------------------------------------------------------
    // Hybrid path.
    // Direction from view-space normal (stable, geometry-driven).
    // Anisotropy from smoothed colour tensor (texture-responsive).
    // -----------------------------------------------------------
    float3 WorldN    = GetWorldNormal(UV);
    float3 ViewN     = mul((float3x3)View.TranslatedWorldToView, WorldN);
    float2 ScreenN   = normalize(ViewN.xy + float2(1e-6, 1e-6));
    float2 StrokeDir = float2(-ScreenN.y, ScreenN.x);

    FTensorData T = ComputeSmoothedTensorFromSceneColor(UV, TexelSize);

    float E = T.A; float F_ = T.B; float G = T.C;
    float Trace   = E + G;
    float Delta   = sqrt(max((E - G) * (E - G) + 4.0 * F_ * F_, 0.0));
    float Lambda1 = 0.5 * (Trace + Delta);
    float Lambda2 = 0.5 * (Trace - Delta);

    FDirectionData Out;
    Out.Direction  = normalize(StrokeDir);
    Out.Angle      = atan2(Out.Direction.y, Out.Direction.x);
    Out.Anisotropy = saturate((Lambda1 - Lambda2) / max(Lambda1 + Lambda2, TENSOR_EPSILON));
    Out.Trace      = Trace;
    return Out;

#else
    // -----------------------------------------------------------
    // Normal-based split pipeline (TENSOR_SOURCE_NORMALS, default).
    // No Gaussian smoothing needed — GBuffer normals are already
    // smooth (interpolated across triangles before storage).
    // -----------------------------------------------------------
    float3 WorldN    = GetWorldNormal(UV);
    float3 ViewN     = mul((float3x3)View.TranslatedWorldToView, WorldN);
    float2 ScreenN   = normalize(ViewN.xy + float2(1e-6, 1e-6));
    float2 StrokeDir = float2(-ScreenN.y, ScreenN.x);

    float2 CurvOffset = TexelSize * TENSOR_CURVATURE_SAMPLE_RADIUS;
    float3 Nx  = GetWorldNormal(UV + float2( CurvOffset.x,  0.0));
    float3 Nxn = GetWorldNormal(UV + float2(-CurvOffset.x,  0.0));
    float3 Ny  = GetWorldNormal(UV + float2( 0.0,  CurvOffset.y));
    float3 Nyn = GetWorldNormal(UV + float2( 0.0, -CurvOffset.y));

    float3 dNdx = (Nx - Nxn) * 0.5;
    float3 dNdy = (Ny - Nyn) * 0.5;

    float E = dot(dNdx, dNdx);
    float F_ = dot(dNdx, dNdy);
    float G = dot(dNdy, dNdy);

    float Trace   = E + G;
    float Delta   = sqrt(max((E - G) * (E - G) + 4.0 * F_ * F_, 0.0));
    float Lambda1 = 0.5 * (Trace + Delta);
    float Lambda2 = 0.5 * (Trace - Delta);

    FDirectionData Out;
    Out.Direction  = normalize(StrokeDir);
    Out.Angle      = atan2(Out.Direction.y, Out.Direction.x);
    Out.Anisotropy = saturate((Lambda1 - Lambda2) / max(Lambda1 + Lambda2, TENSOR_EPSILON));
    Out.Trace      = Trace;
    return Out;
#endif
}

// Legacy — wraps the un-smoothed per-pixel version for backwards compat.
FTensorData AccumulateStructureTensor(float2 UV, float2 TexelSize)
{
    return ComputeTensorSampleFromSceneColor(UV, TexelSize);
}

//////////////////////////////////////////////////////////////
// TENSOR DEBUG VISUALIZERS
//////////////////////////////////////////////////////////////

float3 DebugTensorSourcePreview(float2 UV)
{
#if TENSOR_SOURCE == TENSOR_SOURCE_SCENECOLOR
    float L = GetTonemappedLuma(UV);
    return float3(L, L, L);
#elif TENSOR_SOURCE == TENSOR_SOURCE_HYBRID
    float3 N = GetWorldNormal(UV) * 0.5 + 0.5;
    float  L = GetTonemappedLuma(UV);
    return lerp(float3(L, L, L), N, TENSOR_NORMAL_BLEND);
#else
    return GetWorldNormal(UV) * 0.5 + 0.5;
#endif
}

float3 DebugTensorDirection(float2 Direction)
{
    return float3(Direction * 0.5 + 0.5, 0.0);
}

float3 DebugTensorAnisotropy(float Anisotropy)
{
    return Anisotropy.xxx;
}

float3 DebugTensorTrace(float Trace)
{
    // Scale tuned for the smoothed tensor — the accumulated Gaussian
    // trace is much smaller than a raw single-pixel Sobel trace.
    float T = saturate(Trace * 200.0);
    return float3(T, T, T);
}
