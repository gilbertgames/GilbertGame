#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"

//////////////////////////////////////////////////////////////
// HLSL GLOBAL DECLARATIONS
//
// SHADER_PARAMETER_RDG_TEXTURE and SHADER_PARAMETER_SAMPLER in
// FGilbertPainterlyPS::FParameters handle the C++ binding and
// GPU resource lifetime, but they do NOT auto-generate HLSL
// globals. We must declare them here explicitly so that
// GilbertCommon.ush (and anything it transitively includes)
// can reference them by name.
//
// These must come BEFORE the .ush includes below.
// SHADER_PARAMETER_STRUCT_INCLUDE(FSceneTextureShaderParameters, SceneTextures)
// is the exception — that macro DOES auto-generate its HLSL block
// (SceneTexturesStruct), which is why GetWorldNormal() already works.
//////////////////////////////////////////////////////////////

Texture2D      SceneColorTexture;
SamplerState   SceneColorSampler;

//////////////////////////////////////////////////////////////
// CONFIG OVERRIDES
// Defaults live in each .ush file. Only specify values here
// that you want to deviate from those defaults.
//////////////////////////////////////////////////////////////

// -- Uncomment and set any overrides below --
// #define KUWAHARA_MAX_RADIUS 8
// #define TENSOR_SOURCE TENSOR_SOURCE_SCENECOLOR
// #define TENSOR_NORMAL_BLEND 0.5
// #define DEPTH_RADIUS_ENABLE 0
// #define DETAIL_REINTRODUCTION_ENABLE 0

//////////////////////////////////////////////////////////////
// DEBUG MODE
// These stay here since they are only relevant to the
// entry point, not the helper libraries.
//////////////////////////////////////////////////////////////

#define DEBUG_FINAL_OUTPUT          0
#define DEBUG_TENSOR_DIRECTION      1
#define DEBUG_TENSOR_ANISOTROPY     2
#define DEBUG_KERNEL_ASPECT         3
#define DEBUG_TENSOR_SOURCE_PREVIEW 4
#define DEBUG_TENSOR_TRACE          5
#define DEBUG_PASSTHROUGH           6
#define DEBUG_DEPTH_RADIUS_FACTOR   7
#define DEBUG_DETAIL_ONLY           8
#define DEBUG_LOW_FREQUENCY         9
#define DEBUG_DETAIL_DEPTH_MASK     10
#define DEBUG_COLOR_ONLY_DETAIL     11

#define DEBUG_MODE DEBUG_FINAL_OUTPUT

//////////////////////////////////////////////////////////////
// INCLUDES
// Any overrides above must come before these includes so the
// .ush defaults are skipped where overridden via #ifndef.
//////////////////////////////////////////////////////////////

#include "/GilbertShaders/Private/GilbertCommon.ush"
#include "/GilbertShaders/Private/GilbertTensor.ush"
#include "/GilbertShaders/Private/GilbertKuwahara.ush"

//////////////////////////////////////////////////////////////
// MAIN
//////////////////////////////////////////////////////////////

float4 MainPS(float2 UV : TexCoord) : SV_Target
{
    float2 TexelSize = View.BufferSizeAndInvSize.zw;

    FDirectionData DirectionData = ComputeDirectionData(UV, TexelSize);

    float KernelAspect      = 1.0;
    float DepthRadiusFactor = 0.0;
    float3 KuwaharaColor    = ApplyGeneralizedKuwahara(UV, DirectionData, KernelAspect, DepthRadiusFactor);
    float3 FinalColor       = ComposeFinalPainterlyColor(UV, KuwaharaColor);

#if DEBUG_MODE == DEBUG_TENSOR_DIRECTION
    return float4(DebugTensorDirection(DirectionData.Direction), 1.0);
#elif DEBUG_MODE == DEBUG_TENSOR_ANISOTROPY
    return float4(DebugTensorAnisotropy(DirectionData.Anisotropy), 1.0);
#elif DEBUG_MODE == DEBUG_KERNEL_ASPECT
    return float4(DebugKernelAspect(KernelAspect), 1.0);
#elif DEBUG_MODE == DEBUG_TENSOR_SOURCE_PREVIEW
    return float4(DebugTensorSourcePreview(UV), 1.0);
#elif DEBUG_MODE == DEBUG_TENSOR_TRACE
    return float4(DebugTensorTrace(DirectionData.Trace), 1.0);
#elif DEBUG_MODE == DEBUG_PASSTHROUGH
    return float4(GetSceneColor(UV), 1.0);
#elif DEBUG_MODE == DEBUG_DEPTH_RADIUS_FACTOR
    return float4(DebugDepthRadiusFactor(DepthRadiusFactor), 1.0);
#elif DEBUG_MODE == DEBUG_DETAIL_ONLY
    #if DETAIL_COLOR_ONLY_ENABLE
        return float4(GetColorOnlyHighFrequencyDetail(UV) * 0.5 + 0.5, 1.0);
    #else
        return float4(GetHighFrequencyDetail(UV) * 0.5 + 0.5, 1.0);
    #endif
#elif DEBUG_MODE == DEBUG_LOW_FREQUENCY
    return float4(GetSmallBlurredSceneColor(UV), 1.0);
#elif DEBUG_MODE == DEBUG_DETAIL_DEPTH_MASK
    return float4(GetDetailDepthMask(UV).xxx, 1.0);
#elif DEBUG_MODE == DEBUG_COLOR_ONLY_DETAIL
    return float4(GetColorOnlyHighFrequencyDetail(UV) * 0.5 + 0.5, 1.0);
#else
    return float4(FinalColor, 1.0);
#endif
}
