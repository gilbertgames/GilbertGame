/*=============================================================================
	PostProcessCombineLUTs.usf: Filter pixel shader source.

	This file shadows Engine/Shaders/Private/PostProcessCombineLUTs.usf (UE 5.8).
	The TonemapOverride plugin injects custom tonemapping operators at the
	LUT baking stage (FilmToneMap call), so color grading works properly.

	UE 5.8 port notes:
	* The custom curve replaces FilmToneMap() inside ComputeFilmColorNoGamma(),
	  i.e. the TONEMAPPING_METHOD_Filmic tone curve. If the project runs the
	  ACES 2.0 method (TONEMAPPING_METHOD_ACES), the engine bakes its transform
	  through the InnerLUT instead and the custom modes are bypassed (same
	  deference to ACES the 5.7 plugin had on HDR outputs).
	* ACES-specific steps (wide-gamut expand, blue correction, LUT headroom
	  squish) compile out for custom modes, matching the 5.7 plugin.
	* 5.8 made this pass compute-only and replaced the fixed 1.05 LUT headroom
	  with the LUTInvMax/LUTMax uniform pair.

	Note: Any changes to device encoding logic in CombineLUTsCommon() must
	also be made in PostProcessDeviceEncodingOnly.usf.
=============================================================================*/

#include "Common.ush"
#include "PostProcessCommon.ush"
#include "TonemapCommon.ush"

// Values:
//   0 = ACES Filmic (engine default FilmToneMap)
//   1 = AgX (Punchy)
//   2 = Reinhard
//   3 = Linear (no tonemapping)
//   4 = Khronos PBR Neutral
//   5 = Custom (see CustomTonemapOperator below)


#define CUSTOM_TONEMAP_MODE 1  // Change this to switch tonemappers


// 0: Default, 1: Golden, 2: Punchy

#define AGX_LOOK 2

